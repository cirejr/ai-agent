{
  "name": "erwin-ai",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "lint": "eslint .",
    "typecheck": "bun run --filter '@erwin-ai/*' typecheck",
    "format": "prettier --write .",
    "format:check": "prettier . --check",
    "test": "bun test",
    "build": "tsc -b",
    "prepare": "husky",
    "check:deps": "knip",
    "verify": "bun run check:deps && bun run typecheck && bun run format:check && bun run lint && bun run test && bun run build"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.14",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6",
    "typescript-eslint": "^8.71.2"
  }
}
